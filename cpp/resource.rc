#include <windows.h>

1 ICON "../ico/linkbar.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,6,9,0
 PRODUCTVERSION 1,6,9,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904E4"
        BEGIN
            VALUE "CompanyName", "Asaq"
            VALUE "FileDescription", "Linkbar - Windows desktop toolbar"
            VALUE "FileVersion", "1.6.9.0"
            VALUE "InternalName", "Linkbar"
            VALUE "LegalCopyright", "Copyright (c) 2010-2021 Asaq"
            VALUE "OriginalFilename", "linkbar.exe"
            VALUE "ProductName", "Linkbar"
            VALUE "ProductVersion", "1.6.9.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1252
    END
END
